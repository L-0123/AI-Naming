# ============================================================
# 多模型配置：四家都走 OpenAI 兼容的 /chat/completions
# 密钥只放环境变量，代码里不出现明文；缺哪家就只影响那一家
# ============================================================

# ---- 豆包 Doubao（火山方舟）----
# 位置：https://console.volcengine.com/ark → API Key 管理
DOUBAO_API_KEY=your_doubao_api_key_here
# 选填，默认 doubao-seed-2-1-pro-260915（方舟模型广场查看）
DOUBAO_MODEL=doubao-seed-2-1-pro-260915

# ---- DeepSeek ----
# 位置：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 选填，默认 deepseek-chat（也可填 deepseek-reasoner）
DEEPSEEK_MODEL=deepseek-chat

# ---- 通义千问 Qwen（阿里云百炼 / DashScope）----
# 位置：https://bailian.console.aliyun.com/?apiKey=1 → 创建并复制 API-KEY
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# sk-ws- 开头的新版业务空间密钥必须配专属域名，在同一个页面「按量付费 Base URL」处复制
DASHSCOPE_BASE_URL=https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 选填，默认 qwen-plus（也可填 qwen-max / qwen-turbo 等）
QWEN_MODEL=qwen-plus

# ---- Kimi（月之暗面）----
# 位置：https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=your_kimi_api_key_here
# 选填，默认 moonshot-v1-32k
KIMI_MODEL=moonshot-v1-32k

# ---- Supabase（保存记录用）----
# 位置：Supabase 控制台 → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
# anon public key（新版控制台叫 publishable key: sb_publishable_xxx）
# 使用 anon key 时，务必在 Supabase 执行：
#   grant usage on schema public to anon;
#   grant select, insert on public.naming_records to anon;
#   grant usage, select on sequence public.naming_records_id_seq to anon;
SUPABASE_ANON_KEY=your_anon_key_here
# 如改用服务端密钥（可绕过 RLS），配置该项后会优先使用
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# 选填，默认 naming_records
SUPABASE_TABLE=naming_records
